{
  "name": "little-playground",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/client",
    "build": "npm run build -w apps/client",
    "check": "tsc --noEmit -p apps/client",
    "check:legacy": "tsc --noEmit -p apps/server",
    "dev:server": "npm run dev -w apps/server",
    "test:legacy": "tsx --test tests/*.test.ts",
    "test": "tsx --test tests/life/*.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "client-alt",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": [
        "vite",
        "apps/client",
        "--host",
        "127.0.0.1",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "url": "http://127.0.0.1:5174"
    },
    {
      "name": "dist-preview",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": [
        "vite",
        "preview",
        "apps/client",
        "--host",
        "127.0.0.1",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175,
      "url": "http://127.0.0.1:5175"
    }
  ]
}